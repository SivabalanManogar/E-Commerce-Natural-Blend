rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Customers collection: Allow profile sync & access
    match /customers/{uid} {
      allow read, write: if true;
    }

    // Products collection: Anyone can read products and update stock on purchase
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories collection: Anyone can read and subscribe to categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Subcategories collection: Anyone can read and subscribe to subcategories
    match /subcategories/{subCategoryId} {
      allow read, write: if true;
    }

    // Orders collection: Allow order creation, reading, updating and deletion
    match /orders/{orderId} {
      allow create, read, update, delete: if true;
    }

    // Contact messages: Anyone can send, read, or manage contact messages
    match /contactMessages/{messageId} {
      allow create, read, update, delete: if true;
    }
  }
}

